<div>
  <%= form_with model: location do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name %>
  <%= form.label :description %>
  <%= form.text_area :description %>
  <%= form.submit %>
  <%= link_to "Cancel", (current_page?(new_location_path) ? locations_path : location_path(location)) %>
  <% end %>
</div>
