<div>
  <%= form_with model: location do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name %>
    <% if location.errors[:name].any? %>
      <div class="error-message">
        <% location.errors[:name].each do |error| %>
          <div><%= error %></div>
        <% end %>
      </div>
    <% end %>
    <%= form.label :description %>
    <%= form.text_area :description %>
    <%= form.submit %>
    <%= link_to "Cancel", (action_name.in?(%w[new create]) ? locations_path : location_path(location)) %>
  <% end %>
</div>
