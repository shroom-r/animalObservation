<h1>Locations</h1>
<div>
  <%= link_to "New Location", new_location_path %>
</div>
<ul class="">
  <% @locations.each do |location| %>
    <li>
      <%= link_to location do %>
        <div>ID:<%= location.id %> <%= location.name %></div>
      <% end %>
    </li>
    <small><%= t '.last_observations_count', count: location.observations.last(3).size %></small>
    <%= render "observations/observations_list", location: location, observations: location.observations.last(3) %>
  <% end %>
</ul>
