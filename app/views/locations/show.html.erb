<h2 class="flex-title">
  <%= link_to "", "/", title: "Home", class: "home-link" %>
  <%= @location.name %>
  <%=
    link_to "",
    edit_location_path(@location),
    title: "Edit location",
    class: "edit-button"
  %>
  <%=
    link_to "",
    location_path(@location),
    title: "Delete location",
    data: {
      turbo_method: :delete,
      turbo_confirm: "Are you sure you want to delete this location ?"
    },
    class: "delete-button-big"
  %>
</h2>

<% if @location.description.present? %>
  <em><%= @location.description %></em>
<% end %>

<h4>List of observations</h4>
<%= link_to "Add new observation", new_location_observation_path(@location) %>
<div><%= t '.observations_count', count: @observations.size %></div>
<%= render "observations/observations_list", location: @location, observations: @observations %>
