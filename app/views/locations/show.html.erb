<%= render "layouts/homeLink" %>
<h1 class="flex-title">
  <%= @location.name %>
  <%=
    link_to "",
    location_path(@location),
    data: {
      turbo_method: :delete,
      turbo_confirm: "Are you sure you want to delete this location ?"
    },
    class: "delete-button-big"
  %>
</h1>

<% if @location.description %>
  <p><%= @location.description %></p>
<% end %>

<h3>List of observations</h3>
<%= link_to "Add new observation", new_location_observation_path(@location) %>
<div><%= t '.observations_count', count: @location.observations.size %></div>
<%= render "observations/observations_list", location: @location, observations: @location.observations %>
