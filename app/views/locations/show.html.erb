<h1 class="flex-title">
  <%= @location.name %>
  <%=
    link_to "",
    location_path(@location),
    data: {
      turbo_method: :delete,
      turbo_confirm: "Are you sure you want to delete this location ?"
    },
    class: "delete-button-big"
  %>
</h1>

<% if @location.description %>
  <p><%= @location.description %></p>
<% end %>

<%= render "observations/observations_list", location: @location, observations: @location.observations %>
