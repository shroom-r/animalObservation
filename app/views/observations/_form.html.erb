<div>
  <%= form_with model: [@location, @observation] do |form| %>
    <%= form.label :animalName, "Animal name" %>
    <%= form.text_field :animalName %>
    <% if observation.errors[:animalName].any? %>
      <div class="error-message">
        <% observation.errors[:animalName].each do |error| %>
          <div><%= error %></div>
        <% end %>
      </div>
    <% end %>
    <%= form.label :quantity %>
    <%= form.number_field :quantity %>
    <%= form.label :description %>
    <%= form.text_area :description %>
    <%= form.label :observationDate %>
    <%= form.date_select :observationDate %>
    <div>
      <%= form.submit %>
      <%= link_to "Cancel", location_path(@location) %>
    </div>
  <% end %>
</div>
