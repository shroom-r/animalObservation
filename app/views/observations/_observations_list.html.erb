<% if observations.any? %>
  <ul class="flex-list">
    <% observations.each do |observation| %>
      <li class="flex-list-element">
        <div class="animal-info">
          <%= link_to edit_location_observation_path(location, observation), class: "list-link" do %>
            <%= observation.animalName %>
          <% end %>
          <div
            class="info"
            title="Quantity: <%=observation.quantity %>&#013;Description: <%= observation.description %>"
          ></div>
          <small><em><%= observation.observationDate.strftime("%d.%m.%y") %></em></small>
        </div>
        <% if current_page?(location_path(location)) %>
          <%= link_to "",
            location_observation_path(location, observation),
            title: "Delete observation",
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure you want to delete this observation ?"
            },
            class: "delete-button-small"
          %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div>No observation yet</div>
<% end %>